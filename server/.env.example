# Copier en .env (jamais commité) puis adapter. Sans .env, le serveur démarre en développement avec des valeurs locales.
NODE_ENV=development
PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=miniprojet
# En production : obligatoire, ni vide, ni « miniprojet-dev », et DB_USER ne peut pas être root.
DB_PASSWORD=miniprojet-dev
DB_NAME=miniprojet

# Signe les jetons de connexion. Obligatoire en production, 32 caractères au moins :
#   openssl rand -base64 48
# En développement, un secret est inventé à chaque démarrage (les sessions ne survivent pas à un redémarrage).
JWT_SECRET=
JWT_TTL_SECONDS=604800

IMAGES_DIR=./images
MAX_IMAGE_BYTES=5242880

# À mettre à true derrière un reverse proxy (nginx, Traefik) pour que le limiteur voie l'adresse du visiteur.
TRUST_PROXY=false
