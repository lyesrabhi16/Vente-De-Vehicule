<?xml version="1.0" encoding="utf-8"?>
<!-- Un résultat de recherche : une personne ou une annonce (SearchResultRecyclerViewAdapter n'en montre qu'un des deux). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/container_person"
        layout="@layout/person_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <include
        android:id="@+id/container_annonce"
        layout="@layout/annonce"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
