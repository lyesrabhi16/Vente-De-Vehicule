<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème de l'application : Material 3, palette GetCars (voir colors.xml), clair et sombre. -->
    <style name="Theme.MiniProjet" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/gc_primary</item>
        <item name="colorOnPrimary">@color/gc_on_primary</item>
        <item name="colorPrimaryContainer">@color/gc_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/gc_on_primary_container</item>
        <item name="colorSecondary">@color/gc_secondary</item>
        <item name="colorOnSecondary">@color/gc_on_secondary</item>
        <item name="colorSecondaryContainer">@color/gc_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/gc_on_secondary_container</item>
        <item name="colorTertiary">@color/gc_tertiary</item>
        <item name="colorOnTertiary">@color/gc_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/gc_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/gc_on_tertiary_container</item>
        <item name="colorError">@color/gc_error</item>
        <item name="colorOnError">@color/gc_on_error</item>
        <item name="colorErrorContainer">@color/gc_error_container</item>
        <item name="colorOnErrorContainer">@color/gc_on_error_container</item>
        <item name="android:colorBackground">@color/gc_background</item>
        <item name="colorOnBackground">@color/gc_on_surface</item>
        <item name="colorSurface">@color/gc_surface</item>
        <item name="colorOnSurface">@color/gc_on_surface</item>
        <item name="colorSurfaceVariant">@color/gc_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/gc_on_surface_variant</item>
        <item name="colorOutline">@color/gc_outline</item>
        <item name="colorOutlineVariant">@color/gc_outline_variant</item>

        <item name="android:statusBarColor">@color/gc_background</item>
        <item name="android:navigationBarColor">@color/gc_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">@bool/gc_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/gc_light_bars</item>

        <item name="materialCardViewStyle">@style/Widget.GetCars.Card</item>
        <item name="bottomNavigationStyle">@style/Widget.GetCars.BottomNavigation</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.GetCars.Medium</item>
    </style>

    <style name="Theme.MiniProjet.Fullscreen" parent="Theme.MiniProjet">
        <item name="android:actionBarStyle">@style/Widget.Theme.MiniProjet.ActionBar.Fullscreen</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="ThemeOverlay.MiniProjet.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/gc_primary</item>
        <item name="fullscreenTextColor">@color/gc_on_primary</item>
    </style>

    <style name="BlueSearchViewTheme">
        <item name="colorControlNormal">@color/gc_on_surface_variant</item>
    </style>
</resources>
